# Copy this file to .env and fill in the values from your Firebase project
# (Firebase Console > Project Settings > General > Your apps > SDK setup).
# These are not secret keys, but they are project-specific.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From Google Cloud Console > APIs & Services > Credentials, OAuth 2.0 Client IDs
# (created automatically when you enable Google as a Firebase Auth sign-in provider).
# WEB_CLIENT_ID is used both for the web sign-in flow and passed to the native
# Google Sign-In SDK (required so the ID token's audience matches what Firebase
# expects) — set it for every platform. IOS_CLIENT_ID is only needed once you
# build an iOS dev client. ANDROID_CLIENT_ID isn't read directly in code, but
# an Android OAuth client (tied to the app's package name + SHA-1 fingerprint)
# must still exist in Google Cloud Console for native Android sign-in to work
# — Google Sign-In does not work inside Expo Go, only in a custom dev build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
